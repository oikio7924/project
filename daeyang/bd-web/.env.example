# MariaDB
MARIADB_HOST=127.0.0.1
MARIADB_PORT=3306
MARIADB_USER=root
MARIADB_PASSWORD=
MARIADB_DATABASE=bdweb

# DB 초기화 (false: 기존 데이터 유지 / true: 시작 시 테이블 재생성)
DB_RESET=false

# 서버
PORT=3001
SITE_DOMAIN=http://localhost:3001
BASE_PATH=/bdweb
SESSION_SECRET=

# NAS 서류 연동 (Synology File Station, 읽기 전용) — NAS_URL 이 비어 있으면 NAS 기능 꺼짐
NAS_URL=
NAS_USER=
NAS_PASS=
NAS_ROOT=
