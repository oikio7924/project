# MariaDB (모니터링 DB — rtm_* 테이블과 dy_power_plant 가 있는 곳)
MARIADB_HOST=127.0.0.1
MARIADB_PORT=3306
MARIADB_USER=rtuweb
MARIADB_PASSWORD=
MARIADB_DATABASE=monitering

# 서버 (Apache: ProxyPass /rtuweb http://127.0.0.1:3003/rtuweb)
PORT=3003
BASE_PATH=/rtuweb
SESSION_SECRET=

# 카카오 지도 JavaScript 키 (홈페이지 DAUM_APPKEY 와 같은 값)
KAKAO_JS_KEY=

# 새 계정·비밀번호 재설정 때 쓰는 기본 비밀번호 (scripts/create-user.js)
DEFAULT_PASSWORD=
